.env
.venv/
__pycache__/
.pytest_cache/
*.py[cod]
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.pem
*.key
artifacts/

# Local environment variants (keep shareable examples)
.env.*
!.env.example
!.env.*.example

# Python packaging output
*.egg-info/
build/
dist/
.eggs/

# Additional local environments and tool caches
venv/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Coverage output
.coverage
.coverage.*
htmlcov/
coverage.xml

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Benchmark source/tests are tracked; never commit runtime results or local backups.
benchmarks/**/*.bak
benchmarks/**/*.orig
bench-results/
# M7.8 operator-side activation lock and recoverable staging directories
release-active/.release-activation.lock
.policy-stage-*/
.policy-backup-*/
.policy-unpublished-*/

# Signed deployment state is operator-owned, never Git-managed.
# Do not run git clean -fdx in a deployed checkout.
.runtime/
.runtime-migration-*/
