{
  "threshold": 0.5,
  "entity_categories": [
    "EMAIL_ADDRESS",
    "PHONE_NUMBER",
    "PERSON",
    "LOCATION",
    "CREDIT_CARD",
    "US_SSN",
    "IBAN_CODE",
    "API_CREDENTIAL",
    "PRIVATE_KEY"
  ],
  "required_coverage": [
    "EMAIL_ADDRESS",
    "PHONE_NUMBER",
    "PERSON",
    "CREDIT_CARD",
    "US_SSN",
    "API_CREDENTIAL",
    "PRIVATE_KEY"
  ],
  "sensitivity_mapping": {
    "EMAIL_ADDRESS": "MEDIUM",
    "PHONE_NUMBER": "MEDIUM",
    "PERSON": "MEDIUM",
    "LOCATION": "MEDIUM",
    "CREDIT_CARD": "HIGH",
    "US_SSN": "HIGH",
    "IBAN_CODE": "HIGH",
    "API_CREDENTIAL": "HIGH",
    "PRIVATE_KEY": "HIGH"
  },
  "patterns": {
    "API_CREDENTIAL": [
      [
        "aws-access-key",
        "\\bAKIA[0-9A-Z]{16}\\b",
        0.99
      ],
      [
        "openai-style-key",
        "\\bsk-[A-Za-z0-9_-]{16,}\\b",
        0.98
      ],
      [
        "github-pat",
        "\\bgh[pousr]_[A-Za-z0-9]{20,}\\b",
        0.98
      ]
    ],
    "PRIVATE_KEY": [
      [
        "complete-pem-private-key-block",
        "-----BEGIN (?P<key_label>(?:RSA |EC |OPENSSH |ENCRYPTED )?PRIVATE KEY)-----[\\s\\S]{0,8192}?-----END (?P=key_label)-----",
        0.99
      ],
      [
        "pem-private-key-header",
        "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
        0.99
      ]
    ],
    "EMAIL_ADDRESS": [
      [
        "standard-email",
        "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
        0.97
      ]
    ],
    "US_SSN": [
      [
        "syntactic-ssn-conservative",
        "(?<![A-Za-z0-9])(?!(?:000|666|9[0-9]{2})[- .])[0-9]{3}[- .](?!00)[0-9]{2}[- .](?!0000)[0-9]{4}(?![A-Za-z0-9])",
        0.87
      ]
    ],
    "PERSON": [
      [
        "multiline-capitalized-name-conservative",
        "(?<![A-Za-z])(?-i:(?:[A-Z][a-z]{1,39}|[A-Z]{2,40})[ \\t]*\\r?\\n[ \\t]*(?:[A-Z][a-z]{1,39}|[A-Z]{2,40}))(?![A-Za-z])",
        0.93
      ]
    ],
    "LOCATION": [
      [
        "us-city-full-state",
        "(?-i:\\b(?:Salt[ \\t]+Lake[ \\t]+City|(?:St\\.|Ft\\.)[ \\t]+[A-Z][a-z]+|(?:New|Los|San|Las|Fort|Lake|North|South|West|East|Grand|El|Baton|Santa|Palo|Mount|Saint)[ \\t]+[A-Z][a-z]+|[A-Z][a-z]+),[ \\t]+(?:Alabama|Alaska|Arizona|Arkansas|California|Colorado|Connecticut|Delaware|Florida|Georgia|Hawaii|Idaho|Illinois|Indiana|Iowa|Kansas|Kentucky|Louisiana|Maine|Maryland|Massachusetts|Michigan|Minnesota|Mississippi|Missouri|Montana|Nebraska|Nevada|New Hampshire|New Jersey|New Mexico|New York|North Carolina|North Dakota|Ohio|Oklahoma|Oregon|Pennsylvania|Rhode Island|South Carolina|South Dakota|Tennessee|Texas|Utah|Vermont|Virginia|Washington|West Virginia|Wisconsin|Wyoming)\\b)",
        0.96
      ]
    ],
    "PHONE_NUMBER": [
      [
        "north-american-number",
        "(?<![A-Za-z0-9])(?:\\+1[\\s.-]?)?(?:\\([2-9][0-9]{2}\\)|[2-9][0-9]{2})[\\s.-]?[2-9][0-9]{2}[\\s.-]?[0-9]{4}(?![A-Za-z0-9])",
        0.96
      ]
    ]
  }
}
