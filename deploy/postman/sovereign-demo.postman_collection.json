                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test(\"Input classification\", () => { pm.expect(r.classification.status).to.eql(\"PRIVATE\"); });",
                  "pm.test(\"Input decision\", () => { pm.expect(r.decision.effect).to.eql(\"DENY\"); });",
                  "pm.test(\"HTTP outcome\", () => { pm.expect(pm.response.code).to.be.oneOf([403]); });",
