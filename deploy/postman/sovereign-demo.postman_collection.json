{
  "info": {
    "name": "Sovereign AI Control Plane | Submission Demo v2",
    "description": "Synthetic demo; send each POST then matching GET. Tests inspect evidence, not cryptographic signatures. Expected input decisions must match the installed signed release. Use cases 01–03 in sovereign-only mode.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Readiness",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/health/ready"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Non-private data: permit",
      "item": [
        {
          "name": "A - Submit prompt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/v1/prompts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Explain network segmentation.\",\n  \"destination_id\": \"sovereign-model\",\n  \"purpose\": \"GENERAL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"demoRequestId1\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test(\"Input classification\", () => { pm.expect(r.classification.status).to.eql(\"NO_PRIVATE_DETECTED\"); });",
                  "pm.test(\"Input decision\", () => { pm.expect(r.decision.effect).to.eql(\"PERMIT\"); });",
                  "pm.test(\"HTTP outcome\", () => { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test(\"Request ID returned\", () => { pm.expect(r.request_id).to.be.a(\"string\").and.not.empty; });",
                  "if (typeof r.request_id === \"string\" && [200,403].includes(pm.response.code)) pm.collectionVariables.set(\"demoRequestId1\", r.request_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "B - Retrieve matching audit evidence",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/v1/requests/{{demoRequestId1}}"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"demoRequestId1\")) throw new Error(\"Run the paired POST first.\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
                  "pm.test(\"Matching request ID\", () => { pm.expect(r.request_id).to.eql(pm.collectionVariables.get(\"demoRequestId1\")); });",
                  "pm.test(\"Decision and outcome events\", () => { pm.expect(r.events.map(e => e.event.event_type)).to.include.members([\"DECISION\",\"OUTCOME\"]); });",
                  "pm.test(\"Model invoked\", () => { pm.expect(r.events.find(e => e.event.event_type === \"OUTCOME\").event.payload.model_invoked).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Synthetic private credential: deny",
