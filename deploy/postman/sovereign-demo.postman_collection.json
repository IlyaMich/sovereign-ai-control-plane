              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"demoRequestId7\")) throw new Error(\"Run the paired POST first.\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
                  "pm.test(\"Matching request ID\", () => { pm.expect(r.request_id).to.eql(pm.collectionVariables.get(\"demoRequestId7\")); });",
                  "pm.test(\"Decision and outcome events\", () => { pm.expect(r.events.map(e => e.event.event_type)).to.include.members([\"DECISION\",\"OUTCOME\"]); });",
                  "pm.test(\"Model invoked\", () => { pm.expect(r.events.find(e => e.event.event_type === \"OUTCOME\").event.payload.model_invoked).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
