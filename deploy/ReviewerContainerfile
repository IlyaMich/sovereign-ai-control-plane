FROM docker.io/openpolicyagent/opa:1.8.0 AS opa-cli
FROM docker.io/library/python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /service
COPY --from=opa-cli /opa /usr/local/bin/opa
RUN pip install --no-cache-dir 'cryptography>=43,<47' 'httpx>=0.27,<1'
COPY app/ ./app/
COPY tools/ ./tools/
ENTRYPOINT ["python", "-m", "tools.replay_decisions"]
