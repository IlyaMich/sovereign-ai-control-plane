FROM docker.io/library/python:3.12.16-alpine3.23
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 TLDEXTRACT_PUBLIC_SUFFIX_LIST_URLS=""
ARG DETECTOR_MANIFEST_PATH=/service/detector-active/manifest.json
ENV DETECTOR_MANIFEST_PATH=${DETECTOR_MANIFEST_PATH}
# Most Python NLP extension wheels are distributed as musllinux binaries.
# Upgrade installed Alpine packages to current security-patched versions.
RUN apk upgrade --no-cache && apk add --no-cache libstdc++
WORKDIR /service
COPY pyproject.toml ./
COPY app/ ./app/
COPY simulator/ ./simulator/
COPY tools/ ./tools/
RUN pip install --no-cache-dir .
# Pin the model artifact at build time; no model download on sensitive request paths.
# GitHub access is needed only during image build.
RUN pip install --no-cache-dir "https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl"
RUN python -c "import spacy; n=spacy.load('en_core_web_sm'); assert n.meta['version'] == '3.8.0'"
# Capture installed *bytes* after installing all detector dependencies.
RUN python -m tools.build_detector_manifest --output "$DETECTOR_MANIFEST_PATH"
RUN python -m tools.verify_detector_manifest --manifest "$DETECTOR_MANIFEST_PATH"
# Own new audit volumes as the application UID. Existing root-owned volumes
# require a controlled ownership migration before switching to this image.
RUN mkdir -p /var/lib/sovereign && chown 10001:10001 /var/lib/sovereign
ENV HOME=/tmp XDG_CACHE_HOME=/tmp/.cache
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "tools.run_control_plane"]
