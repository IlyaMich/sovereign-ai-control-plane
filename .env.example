# Copy to .env at repository root; replace with a securely generated value.
CONTROL_PLANE_API_KEY=replace-with-a-random-key
# Structured operational logs: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
ENABLE_EXTERNAL_SIMULATOR=false
# Requires an approved v5 policy/release and verified post-mask inspection.
OUTPUT_MASKING_ENABLED=false
REQUIRE_SIGNED_RELEASE=true

# Published host binding; container port remains 8000.
API_HOST=127.0.0.1
API_PORT=8000

# UTF-8 byte limits. Body limit must exceed prompt limit for JSON overhead.
MAX_PROMPT_BYTES=8192
MAX_REQUEST_BODY_BYTES=16384
# Separate downstream allowance: increase if redaction expands prompts.
MAX_FORWARDED_PROMPT_BYTES=8192

# Per control-plane worker; requests above the limit receive HTTP 429.
MAX_INFLIGHT_REQUESTS=8

# Bound ASGI requests before JSON buffering; Uvicorn also caps connections/tasks.
MAX_ACTIVE_HTTP_REQUESTS=32
# Total body-read deadline across all chunks; expires with HTTP 408.
BODY_READ_TIMEOUT_SECONDS=10.0
UVICORN_LIMIT_CONCURRENCY=96
UVICORN_KEEPALIVE_SECONDS=5

# One detector thread per API worker. Max jobs includes running + queued jobs.
MAX_DETECTOR_JOBS=8
# Maximum time waiting to reserve a detector submission slot (not NLP runtime).
DETECTOR_QUEUE_WAIT_SECONDS=1.0

# One audit executor thread per API worker; includes running and queued jobs.
MAX_AUDIT_JOBS=16

# M7.7 request-time artifact verification (2 worker threads), plus
# an isolated singleflight full-model readiness verifier.
MAX_INTEGRITY_JOBS=8
MAX_INTEGRITY_WAITERS=8
INTEGRITY_QUEUE_WAIT_SECONDS=1.0
# Pending capacity waiters above the queue bound fail immediately.
MAX_AUDIT_WAITERS=8
# Only this many auxiliary SQLite jobs (read/probe/idempotency) may be active.
MAX_AUDIT_AUXILIARY_JOBS=4

# Process-local diagnostic sampling; no request bodies are recorded.
LOOP_LAG_INTERVAL_SECONDS=0.25
METRICS_SAMPLE_WINDOW=512
# Time limit for audit queue admission (not a database commit timeout).
AUDIT_QUEUE_WAIT_SECONDS=1.0

# Positive, finite durations in seconds.
OPA_TIMEOUT_SECONDS=2.0
MODEL_TIMEOUT_SECONDS=10.0
READINESS_TIMEOUT_SECONDS=1.0
SIMULATOR_EGRESS_TIMEOUT_SECONDS=5.0

OPA_URL=http://opa:8181
MODEL_URL=http://sovereign-model:9000
EGRESS_GATEWAY_URL=http://egress-gateway:9010
SIMULATOR_UPSTREAM_URL=http://external-simulator:9000
EXPECTED_POLICY_REVISION=redaction-response-dlp-v5

# Paths below are inside containers. Host policy/release/trust sources live in
# Git-ignored .runtime/ (Compose bind mounts); do not edit legacy tracked samples.
# Migrate existing deployments before switching to this Compose configuration:
# docs/operator-state-migration.md
ACTIVE_POLICY_PATH=/policy-active
POLICY_ARCHIVE_PATH=/policy-archive
RELEASE_ACTIVE_DIR=/release-active
RELEASE_ARCHIVE_PATH=/release-archive
RELEASE_TRUST_PATH=/release-trust
AUDIT_DATA_DIR=/var/lib/sovereign
# Optional file-path overrides must stay beneath the corresponding mounted directory.
# RELEASE_ACTIVE_PATH=/release-active/release.json
# AUDIT_DB_PATH=/var/lib/sovereign/audit.sqlite
# AUDIT_SIGNING_KEY_PATH=/var/lib/sovereign/audit-key.pem
# DETECTOR_ARCHIVE_PATH=/var/lib/sovereign/detector-archive
# Changing the manifest path requires rebuilding, signing, and activating a release.
DETECTOR_MANIFEST_PATH=/service/detector-active/manifest.json

# Detector threshold, categories, sensitivities, coverage, and regex rules:
# edit app/detection/rules.json, then rebuild and approve a new signed release.
